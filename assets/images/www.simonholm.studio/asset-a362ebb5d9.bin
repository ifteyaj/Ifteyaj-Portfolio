body.color-theme.warm {
    --text-gray: var(--BgHue), 30%, 90%; /* Warmer gray */
    --blend-mode: plus-lighter;
}

body.color-theme.cold {
    --text-gray: var(--BgHue), 25%, 90%; /* Cooler gray */
    --blend-mode: plus-lighter;
}

body.light-theme.warm {
    --text-gray: var(--BgHue), 35%, 17%; /* Warmer gray */
    --LightModeBlack: var(--BgHue), 8%, 20%;
    --blend-mode: none;
}

body.light-theme.cold {
    --text-gray: var(--BgHue), 25%, 17%; /* Cooler gray */
    --LightModeBlack: var(--BgHue), 5%, 20%;
    --blend-mode: none;
}
  body.color-theme{
--text-opacity:0.45;
}
  
    body.light-theme{
--text-opacity:0.45;
}


/* Light theme specific styles */
body.light-theme .menu-big-text,
body.light-theme .menu-small-text,
body.light-theme .nav-clock-infomation,
