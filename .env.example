# Canonical production origin used by metadata, sitemap and structured data.
# Set this in Vercel for the Production environment, then add the domain in
# Vercel Project Settings → Domains.
NEXT_PUBLIC_SITE_URL=https://ifteyaj-portfolio.vercel.app

# Google Search Console verification token for the URL-prefix property
# (HTML tag method). Paste only the token, not the whole
# "google-site-verification=..." string. Optional: layout.tsx falls back to the
# committed token, so verification works on every deploy without this variable.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# Contact form (Resend) — server-side only, used by /api/contact.
# Add these in Vercel → Project → Settings → Environment Variables for both
# Production and Preview, then redeploy so the route can read them.
# Without them the route returns 503 and the form shows its mailto: fallback.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
